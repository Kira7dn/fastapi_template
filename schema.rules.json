{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/workflow-input.rules.schema.json",
  "title": "Workflow Input Rules",
  "type": "array",
  "items": { "$ref": "#/$defs/item" },
  "$defs": {
    "nameTypeString": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\s*:\\s*.+$",
      "examples": [
        "id: int",
        "name: str",
        "products: list[Product]",
        "q: str = 'default'"
      ]
    },

    "method": {
      "type": "object",
      "required": ["method_name"],
      "properties": {
        "method_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/nameTypeString" }
        },
        "return_type": { "type": "string" }
      },
      "additionalProperties": false
    },

    "base": {
      "type": "object",
      "required": ["class_name", "layer"],
      "properties": {
        "class_name": { "type": "string", "minLength": 1 },
        "layer": {
          "type": "string",
          "enum": [
            "domain/entity",
            "domain/service",
            "application/interface",
            "application/use_case",
            "infrastructure/model",
            "infrastructure/repository",
            "infrastructure/adapter",
            "infrastructure/pipeline_step",
            "presentation/schema",
            "presentation/dependency",
            "presentation/router"
          ]
        },
        "description": { "type": "string" },

        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/nameTypeString" }
        },
        "methods": {
          "type": "array",
          "items": { "$ref": "#/$defs/method" }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/nameTypeString" }
        },
        "return_type": { "type": "string" },
        "imports": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "inheritance": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },

        "code_path": { "type": "string" },
        "code_raw_url": { "type": "string", "format": "uri" },
        "test_path": { "type": "string" },
        "test_raw_url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },

    "domain_entity": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "layer": { "const": "domain/entity" } },
          "required": ["attributes"]
        }
      ]
    },

    "domain_service": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "layer": { "const": "domain/service" } },
          "required": ["methods"]
        }
      ]
    },

    "application_interface": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "layer": { "const": "application/interface" } },
          "required": ["methods"]
        }
      ]
    },

    "application_use_case": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "layer": { "const": "application/use_case" } },
          "required": ["dependencies", "parameters", "return_type"]
        }
      ]
    },

    "infra_model": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "layer": { "const": "infrastructure/model" } },
          "required": ["attributes"]
        }
      ]
    },

    "infra_repository": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "layer": { "const": "infrastructure/repository" } },
          "required": ["attributes", "methods"]
        }
      ]
    },

    "infra_adapter": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "layer": { "const": "infrastructure/adapter" } },
          "required": ["methods"]
        }
      ]
    },

    "infra_pipeline_step": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "layer": { "const": "infrastructure/pipeline_step" } },
          "required": ["methods"]
        }
      ]
    },

    "presentation_schema": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "layer": { "const": "presentation/schema" } },
          "required": ["attributes"]
        }
      ]
    },

    "presentation_dependency": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "layer": { "const": "presentation/dependency" },
            "methods": {
              "type": "array",
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/method" },
                  { "required": ["return_type"] }
                ]
              }
            }
          },
          "required": ["methods"]
        }
      ]
    },

    "presentation_router": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "layer": { "const": "presentation/router" } },
          "required": ["methods"]
        }
      ]
    },

    "item": {
      "oneOf": [
        { "$ref": "#/$defs/domain_entity" },
        { "$ref": "#/$defs/domain_service" },
        { "$ref": "#/$defs/application_interface" },
        { "$ref": "#/$defs/application_use_case" },
        { "$ref": "#/$defs/infra_model" },
        { "$ref": "#/$defs/infra_repository" },
        { "$ref": "#/$defs/infra_adapter" },
        { "$ref": "#/$defs/infra_pipeline_step" },
        { "$ref": "#/$defs/presentation_schema" },
        { "$ref": "#/$defs/presentation_dependency" },
        { "$ref": "#/$defs/presentation_router" }
      ]
    }
  }
}
